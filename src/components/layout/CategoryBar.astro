---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { Icon } from "astro-icon/components";
import { getSortedPostsList } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

const totalPosts = (await getSortedPostsList()).length;
const homeUrl = url("/");
const archiveUrl = url("/archive/");
---

<div
  class="card-base category-bar p-3 onload-animation"
  id="category-bar"
  data-home-path={homeUrl}
  data-archive-path={archiveUrl}
>
  <div class="flex gap-2">
    <a
      href={homeUrl}
      class="category-pill text-sm px-3 py-1.5 rounded-xl transition-colors duration-150 ease-out flex items-center justify-center"
      data-page="home"
      aria-label={i18n(I18nKey.home)}
    >
      <Icon name="material-symbols:home" is:inline class="text-lg" />
    </a>
    <a
      href={archiveUrl}
      class="category-pill text-sm px-4 py-1.5 rounded-xl whitespace-nowrap transition-colors duration-150 ease-out flex items-center justify-center"
      data-page="archive"
    >
      {i18n(I18nKey.archive)}
      <span class="pill-count">{totalPosts}</span>
    </a>
  </div>
</div>

<style>
  .category-bar {
    margin-bottom: 1rem;
  }
  .category-pill {
    border: none;
    color: var(--btn-content);
    background: color-mix(in srgb, var(--btn-content) 6%, transparent);
    font-weight: 500;
    gap: 0.375rem;
  }
  .category-pill .pill-count {
    font-size: 0.7rem;
    font-weight: 600;
    opacity: 0.5;
    padding: 0.05rem 0.35rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--btn-content) 8%, transparent);
  }
  .category-pill:hover {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 10%, transparent);
  }
  .category-pill[data-active] {
    background: var(--primary);
    color: white;
  }
  .category-pill[data-active] .pill-count {
    background: rgba(255, 255, 255, 0.2);
    opacity: 0.9;
  }
</style>

<script>
  function updateArchiveBar(currentUrl = new URL(window.location.href)) {
    const bar = document.getElementById("category-bar");
    if (!bar) return;

    const pathname = currentUrl.pathname.replace(/\/$/, "");
    const homePath = (bar.getAttribute("data-home-path") || "/").replace(/\/$/, "");
    const archivePath = (bar.getAttribute("data-archive-path") || "/archive").replace(/\/$/, "");

    bar.querySelectorAll<HTMLAnchorElement>(".category-pill").forEach((pill) => {
      pill.removeAttribute("data-active");
    });

    if (pathname === homePath || pathname === "" || pathname === "/") {
      bar.querySelector<HTMLAnchorElement>('[data-page="home"]')?.setAttribute("data-active", "");
    } else if (pathname === archivePath) {
      bar.querySelector<HTMLAnchorElement>('[data-page="archive"]')?.setAttribute("data-active", "");
    }
  }

  updateArchiveBar();
  document.addEventListener("astro:page-load", () => updateArchiveBar());
  document.addEventListener("swup:contentReplaced", () => updateArchiveBar());

  function setupSwupEarlyUpdate() {
    if (!window.swup?.hooks) return;
    window.swup.hooks.on("visit:start", (visit: any) => {
      updateArchiveBar(new URL(visit.to.url, window.location.href));
    });
  }

  if (window.swup?.hooks) {
    setupSwupEarlyUpdate();
  } else {
    document.addEventListener("swup:enable", setupSwupEarlyUpdate);
  }
</script>
