---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Markdown from "@/components/common/Markdown.astro";
import noteMap from "@/data/note-link-map.json";
import { buildNoteGraph } from "@/lib/note-links.mjs";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

export async function getStaticPaths() {
	const allNotes = await getCollection("notes", ({ data }) => {
		return import.meta.env.PROD ? data.draft !== true : true;
	});
	const graph = buildNoteGraph(
		allNotes.map((note) => ({
			id: note.id,
			title: note.data.title,
			body: note.body || "",
		})),
		noteMap,
	);
	const sorted = allNotes.sort((a, b) => {
		const dateA = new Date(a.data.published).getTime();
		const dateB = new Date(b.data.published).getTime();
		return dateB - dateA;
	});
	return sorted.map((note) => ({
		params: { slug: note.id },
		props: {
			note,
			relatedNotes: graph.relatedById[note.id] || [],
			unpublishedRelations: graph.unpublishedById[note.id] || [],
		},
	}));
}

const { note, relatedNotes, unpublishedRelations } = Astro.props;
const { Content } = await render(note);

const title = note.data.title;
const description = note.data.description;
---

<MainGridLayout title={title} description={description}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative mb-4">
    <div
      class="card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full"
    >
      <div class="relative mb-3">
        <div
          class="transition w-full block font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-(--primary)
                    before:absolute before:top-3 before:-left-4.5"
        >
          {title}
        </div>
      </div>

      <!-- metadata -->
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-black/50 dark:text-white/50 mb-5">
        <div class="flex items-center gap-1">
          <Icon name="material-symbols:calendar-month-outline-rounded" class="text-[1.05em]" />
          <span>{new Date(note.data.published).toISOString().slice(0, 10)}</span>
        </div>
        {note.data.category && (
          <div class="flex items-center gap-1">
            <Icon name="material-symbols:folder-outline-rounded" class="text-[1.05em]" />
            <span>{note.data.category}</span>
          </div>
        )}
      </div>

      {note.data.tags && note.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mb-5">
          {note.data.tags.map((tag: string) => (
            <span class="text-xs px-2 py-0.5 rounded bg-(--primary)/10 text-(--primary) font-medium">
              {tag}
            </span>
          ))}
        </div>
      )}

      <div class="border-(--line-divider) border-dashed border-b mt-3 mb-5"></div>

      <Markdown class="mb-6 markdown-content onload-animation">
        <Content />
      </Markdown>

      {(relatedNotes.length > 0 || unpublishedRelations.length > 0) && (
        <section class="note-relations border-(--line-divider) border-dashed border-t pt-5 mt-5">
          <h2 class="text-xl font-bold mb-3 flex items-center gap-2">
            <Icon name="material-symbols:link-rounded" class="text-(--primary)" />
            关联
          </h2>
          <ul class="grid gap-2">
            {relatedNotes.map((relatedNote: { id: string; title: string }) => (
              <li>
                <a
                  href={`/notes/${relatedNote.id}/`}
                  class="block px-3 py-2 rounded bg-black/3 hover:bg-(--primary)/10 dark:bg-white/5 dark:hover:bg-(--primary)/15 transition-colors"
                >
                  {relatedNote.title}
                </a>
              </li>
            ))}
            {unpublishedRelations.map((title: string) => (
              <li class="px-3 py-2 text-black/45 dark:text-white/45">
                {title}
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>
</MainGridLayout>
